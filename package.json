{
  "name": "guangyin-agent-edition",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "光阴对赌 · 全 AI Agent 玩家版（无玩家前端，仅管理员观察与数据导出，本地运行）",
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "agents": "npm --prefix agents run start",
    "server": "npm --prefix server run start",
    "admin:dev": "npm --prefix frontend run dev"
  }
}

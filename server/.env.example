# Required in production — admin console login & image upload APIs
# 格式：等号两侧不要空格，例如 ADMIN_TOKEN=your-secret
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional comma-separated CORS allowlist. Production default is player + admin domains.
# ALLOWED_ORIGINS=https://guangyinduidu.com,https://admin.guangyinduidu.com

# Optional: must match frontend dist/version.json buildId after deploy (reject join/admin auth when stale)
# REQUIRED_CLIENT_BUILD_ID=

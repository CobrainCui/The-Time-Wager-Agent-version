# =============================================================================
# 光阴对赌 · 全 AI Agent 玩家版 —— 本地配置
# 复制本文件为 .env 后填写。所有密钥都只放在这一个文件里。
# =============================================================================

# 管理端登录密钥（本地随便设一个，管理员前端登录时填同一个）
ADMIN_TOKEN=local-admin-token-change-me

# 服务端端口
PORT=3001

# -----------------------------------------------------------------------------
# 6 个 Agent 的 API Key —— 在这里统一填写
# 支持任意 OpenAI 兼容接口（OpenAI / DeepSeek / Qwen / Moonshot / 本地 vLLM 等）
# 留空或保留 placeholder 时，对应 Agent 自动使用内置策略，不调用大模型。
# -----------------------------------------------------------------------------
AGENT_1_API_KEY=sk-placeholder-agent-1
AGENT_2_API_KEY=sk-placeholder-agent-2
AGENT_3_API_KEY=sk-placeholder-agent-3
AGENT_4_API_KEY=sk-placeholder-agent-4
AGENT_5_API_KEY=sk-placeholder-agent-5
AGENT_6_API_KEY=sk-placeholder-agent-6

# 可选：每个 Agent 单独指定 OpenAI 兼容端点和模型
# 不填 BASE_URL 时使用 OpenAI 官方；不填 MODEL 时使用 AGENT_DEFAULT_MODEL
AGENT_1_BASE_URL=
AGENT_1_MODEL=gpt-4o
AGENT_2_BASE_URL=
AGENT_2_MODEL=gpt-4o
AGENT_3_BASE_URL=
AGENT_3_MODEL=gpt-4o
AGENT_4_BASE_URL=
AGENT_4_MODEL=gpt-4o
AGENT_5_BASE_URL=
AGENT_5_MODEL=gpt-4o
AGENT_6_BASE_URL=
AGENT_6_MODEL=gpt-4o

# 共享默认值（当上面的单项留空时生效）
AGENT_DEFAULT_BASE_URL=
AGENT_DEFAULT_MODEL=gpt-4o
AGENT_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Agent 运行时
# -----------------------------------------------------------------------------
# 房间 ID：6 个 Agent 用同一个房间号自动入座
AGENT_ROOM_ID=agent-arena
# 管理员前端会自动看到这个房间
AGENT_SERVER_URL=http://127.0.0.1:3001

# 6 名 Agent 入座后是否自动开局
AGENT_AUTO_START=true
# 一局结束后是否 10 秒后自动开下一局
AGENT_AUTO_RESTART=false
# 是否由 Agent 运行时自动主持拍卖（定焦点、落槌、跳过）
AGENT_AUTO_AUCTION=true

# 没有可用 Key 时是否回退到内置策略（true=可以无 Key 跑完整局）
AGENT_FALLBACK_POLICY=true
# true=强制只用内置策略，不调用任何模型
AGENT_OFFLINE=false

# 单次模型调用超时（毫秒）
AGENT_DECISION_TIMEOUT_MS=90000
# 每次行动的拟人延迟范围（毫秒）
AGENT_ACTION_DELAY_MIN_MS=700
AGENT_ACTION_DELAY_MAX_MS=2200

# 拍卖节奏（毫秒）：无人出价多久后跳过；最后一口后多久落槌
AGENT_AUCTION_PASS_WINDOW_MS=45000
AGENT_AUCTION_HAMMER_WINDOW_MS=18000
# 每个 Agent 在同一张卡上最多做几次加价决策（防止 LLM 反复竞价烧钱）
AGENT_AUCTION_MAX_DECISIONS=3

# 日志级别：debug / info / warn / error
AGENT_LOG_LEVEL=info

# =============================================================================
# 光阴对赌 · Agent 实验版 —— 本地配置
# 复制本文件为 .env 后填写。所有密钥都只放在这一个文件里。
#
# 实验版不提供规则兜底：
#   - 缺少 Key / Key 仍是占位值 → agents 启动时直接报错退出
#   - 模型调用失败 / 输出不合法 → 终止本局并标记失败，不会静默换策略
# 冒烟测试请用：npm run experiment -- --mock --games 1
# =============================================================================

# 管理端登录密钥（本地随便设一个；管理员前端登录时填同一个）
ADMIN_TOKEN=local-admin-token-change-me

# 服务端端口
PORT=3001

# 实验随机种子（可选）。不填则服务端生成一个并在导出中记录。
# 同一 seed + 同一条件 = 可复现的时代顺序、项目发牌与 Agent 座位顺序。
GAME_SEED=20261104

# -----------------------------------------------------------------------------
# 6 个 Agent 的 API Key —— 可以来自不同供应商
# 每个 Agent 独立配置 KEY / BASE_URL / MODEL / PROVIDER。
# 不填 BASE_URL 时使用 OpenAI 官方。
# MODEL 留空 = 使用下面的 AGENT_DEFAULT_MODEL；只有混模型实验才需要逐个填写。
# 注意：逐 Agent 的 MODEL 优先级高于 AGENT_DEFAULT_MODEL。
# -----------------------------------------------------------------------------
AGENT_1_API_KEY=sk-placeholder-agent-1
AGENT_1_BASE_URL=
AGENT_1_MODEL=
AGENT_1_PROVIDER=

AGENT_2_API_KEY=sk-placeholder-agent-2
AGENT_2_BASE_URL=
AGENT_2_MODEL=
AGENT_2_PROVIDER=

AGENT_3_API_KEY=sk-placeholder-agent-3
AGENT_3_BASE_URL=
AGENT_3_MODEL=
AGENT_3_PROVIDER=

AGENT_4_API_KEY=sk-placeholder-agent-4
AGENT_4_BASE_URL=
AGENT_4_MODEL=
AGENT_4_PROVIDER=

AGENT_5_API_KEY=sk-placeholder-agent-5
AGENT_5_BASE_URL=
AGENT_5_MODEL=
AGENT_5_PROVIDER=

AGENT_6_API_KEY=sk-placeholder-agent-6
AGENT_6_BASE_URL=
AGENT_6_MODEL=
AGENT_6_PROVIDER=

# 共享默认值（单项留空时生效）
AGENT_DEFAULT_BASE_URL=
AGENT_DEFAULT_MODEL=gpt-4o

# 所有 Agent 使用同一温度（保持 harness 一致；不要按 Agent 单独改）
AGENT_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# 同一套 Agent Harness（所有 Agent 完全一致）
# -----------------------------------------------------------------------------
AGENT_ROOM_ID=agent-arena
AGENT_SERVER_URL=http://127.0.0.1:3001

AGENT_AUTO_START=true
AGENT_AUTO_RESTART=false
AGENT_AUTO_AUCTION=true
# 0 = 不限制局数；experiment 运行器会自动设置
AGENT_GAME_LIMIT=0
# 启动后等待 6 名 Agent 全部就座的硬超时；超时终止 run（避免无限空等）
AGENT_JOIN_TIMEOUT_MS=90000

# 能力开关（所有 Agent 共用；条件实验用它们切换 C0/C1/C2）
AGENT_CHAT_ENABLED=true
AGENT_MEMORY_ENABLED=true
AGENT_PREDICTION_ENABLED=true

# 每名 Agent 每局 token 上限；超出即终止本局（不回退）
# 注意：规则知识会在每次调用中注入，真实中文用量可能远高于 mock。
# 正式批次前先用 1 局 pilot 实测 usage；保守起点建议 100 万。
AGENT_TOKEN_BUDGET=1000000
# 单次输出上限
AGENT_MAX_OUTPUT_TOKENS=1200
# 单次调用超时（毫秒）
AGENT_DECISION_TIMEOUT_MS=120000
# 网络/JSON 失败重试次数（重试耗尽仍失败 → 终止本局）
AGENT_MAX_RETRIES=3

# 行动拟人延迟（毫秒）——只影响节奏，不影响规则
AGENT_ACTION_DELAY_MIN_MS=300
AGENT_ACTION_DELAY_MAX_MS=900

# 拍卖节奏（毫秒）
AGENT_AUCTION_PASS_WINDOW_MS=45000
AGENT_AUCTION_HAMMER_WINDOW_MS=18000
# 每个 Agent 在同一张卡上最多加价决策次数
AGENT_AUCTION_MAX_DECISIONS=4
# 所有 Agent 共用的拍卖预算上限（占可用财富比例）
AGENT_AUCTION_MAX_WEALTH_RATIO=0.35

# 聊天配额（每名玩家每轮）
CHAT_MAX_PUBLIC_PER_ROUND=6
CHAT_MAX_PRIVATE_PER_ROUND=6

# 日志级别：debug / info / warn / error
AGENT_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 彩票线上随机（与产品版一致）
# true：优先 random.org；失败/超时退回 Node crypto.randomInt
# -----------------------------------------------------------------------------
LOTTERY_ONLINE_RANDOM=true
LOTTERY_RANDOM_TIMEOUT_MS=2500

# -----------------------------------------------------------------------------
# 实验运行器写入（一般不需要手填）
# -----------------------------------------------------------------------------
EXPERIMENT_RUN_ID=
EXPERIMENT_CONDITION=
EXPERIMENT_MANIFEST_ID=
EXPERIMENT_MANIFEST_PATH=
AGENT_PROMPT_VERSION=v3-neutral-2026-11
